import { NextRequest, NextResponse } from "next/server";
import { requireRole } from "@/lib/server-auth";

export async function GET(req: NextRequest) {
  const auth = requireRole(req, ["owner", "accountant", "cashier", "sales", "auditor"]);
  if (!auth.authorized) return auth.response;

  return NextResponse.json({ ok: true, message: "Invoices API ready" });
}

export async function POST(req: NextRequest) {
  const auth = requireRole(req, ["owner", "accountant", "sales"]);
  if (!auth.authorized) return auth.response;

  const payload = await req.json();
  return NextResponse.json({ ok: true, message: "Invoice created", payload }, { status: 201 });
}