// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String        @id @default(uuid())
  name          String
  email         String?
  phone         String?
  taxNumber     String?
  currency      String        @default("YER")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  customers     Customer[]
  vendors       Vendor[]
  invoices      Invoice[]
  expenses      Expense[]
  expenseCategories ExpenseCategory[]
  accounts      Account[]
  journalEntries JournalEntry[]
}

model User {
  id        String     @id @default(uuid())
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id])
  fullName  String
  email     String     @unique
  password  String
  role      String     @default("accountant")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  invoices  Invoice[]
  expenses  Expense[]
  auditLogs AuditLog[]
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  invoices  Invoice[]
}

model Vendor {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  expenses  Expense[]
}

model Invoice {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  invoiceNumber String
  issueDate     DateTime
  dueDate       DateTime?
  status        String      @default("draft")
  subtotal      Int         @default(0)
  taxAmount     Int         @default(0)
  totalAmount   Int         @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         InvoiceItem[]

  @@unique([companyId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  total       Int
  createdAt   DateTime @default(now())
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  // Null means a shared category visible to every company.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  // Code of the expense account (in the company's chart) that expenses of this category post to.
  accountCode String?
  createdAt DateTime @default(now())
  expenses  Expense[]

  @@index([companyId])
}

model Expense {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  vendorId      String
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  expenseNumber String
  expenseDate   DateTime
  amount        Int
  status        String          @default("draft")
  notes         String?
  createdAt     DateTime        @default(now())

  @@unique([companyId, expenseNumber])
}

model JournalEntry {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  entryNumber  String
  entryDate    DateTime
  description  String?
  status       String   @default("draft")
  // Set on a reversing entry: the id of the posted entry it reverses (at most one reversal per entry).
  reversalOfId String?  @unique
  // Set on entries posted automatically from an invoice or expense (one entry per source event).
  sourceType   String?
  sourceId     String?
  sourceEvent  String?
  createdAt    DateTime @default(now())
  lines        JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@unique([companyId, sourceType, sourceId, sourceEvent])
}

model JournalEntryLine {
  id            String        @id @default(uuid())
  journalEntryId String
  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id])
  accountCode   String
  accountName   String
  debit         Int           @default(0)
  credit        Int           @default(0)
  description   String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entityType String
  entityId  String
  createdAt DateTime @default(now())
  metadata  Json?
}


model Account {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  // asset | liability | equity | income | expense
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([companyId, code])
}
